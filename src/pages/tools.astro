
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tools">
  <section class="page-header">
    <div class="container">
      <h1>Tools</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <article class="card">
          <h3>Real Depth Simulator</h3>

          <p>
            Explore depth-dependent defocus blur, visual angle,
            focal distance, and binocular disparity.
          </p>

          <a
            class="card-link"
            href="/tools/real-depth/index.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Launch simulator →
          </a>
        </article>

        <article class="card">
          <h3>P-value Simulator</h3>

          <p>
            Explore sampling distributions, false-positive rates,
            statistical power, and optional stopping.
          </p>

          <a
            class="card-link"
            href="/tools/p-value-simulator/index.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Launch simulator →
          </a>
        </article>

        <article class="card">
          <h3>Test of Independent p-Values (TIVA)</h3>

          <p>
            Assess the distribution of reported p-values across
            studies to explore potential inconsistencies in
            statistical evidence.
          </p>

          <a
            class="card-link"
            href="/tools/tiva/index.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Launch tool →
          </a>
        </article>

        <article class="card">
          <h3>Data Visualization Studio</h3>

          <p>
            Upload datasets and create interactive graphs with
            customizable factors, visual encodings, and
            animated transitions.
          </p>

          <a
            class="card-link"
            href="/tools/data-visualizer/index.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Launch tool →
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
