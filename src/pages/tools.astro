---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tools">
  <section class="page-header">
    <div class="container">
      <h1>Tools</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <article class="card">
          <h3>Real Depth Simulator</h3>

          <p>
            Explore depth-dependent defocus blur, visual angle,
            focal distance, and binocular disparity.
          </p>

          <a
            class="card-link"
            href="/tools/real-depth/index.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            Launch simulator →
          </a>
        </article>

        <article class="card">
          <h3>P-value Simulator</h3>

          <p>
            Explore sampling distributions, false-positive rates,
            statistical power, and optional stopping.
          </p>

          <span class="card-link">
            Coming soon →
          </span>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>