---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Research">
  <section class="page-header">
    <div class="container">
      <h1>Research</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <article class="card">
          <h3>Visual perception & real depth</h3>
          <p>
            Experimental research studying depth, attention, perceptual load,
            binocular vision, and visual processing.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>