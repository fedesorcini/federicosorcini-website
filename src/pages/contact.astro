---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact information for Federico Sorcini."
>
  <section class="page-header">
    <div class="container">
      <h1>Contact</h1>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-layout">

      <div class="contact-column">
        <h2>Email</h2>

        <a
          class="contact-email"
          href="mailto:federico.sorcini@gmail.com"
        >
          federico.sorcini@gmail.com
        </a>
      </div>

      <div class="contact-column">
        <h2>Office</h2>

        <div class="contact-address">
          <strong>Vision Lab</strong><br />
          University of Illinois Urbana-Champaign<br />
          603 East Daniel St.<br />
          Champaign, IL 61820<br />
          Office 514
        </div>
      </div>

    </div>
  </section>
</BaseLayout>